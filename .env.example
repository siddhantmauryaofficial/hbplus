FIREBASE_PROJECT_ID=auth-hbplus
MONGODB_URI=
MONGODB_DB_NAME=hbplus
DNS_SERVERS=8.8.8.8,8.8.4.4
# Choose one server-only credential method. Never commit service-account keys.
# Put the downloaded key in secrets/firebase-service-account.json, or paste its JSON into the variable below.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=.\secrets\firebase-service-account.json
# Generate a private session secret with at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_DOMAIN=hbplus.fit
SKIP_EMAIL_DOMAIN_CHECK=false
PORT=3001
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
